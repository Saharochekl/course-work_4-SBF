# В графе нужны код и лёгкие текстовые результаты. FITS и другие численные
# массивы агент при необходимости читает напрямую специализированными средствами.
astro_env/
output/
tmp/
.matplotlib/
code/.matplotlib/
code/runs/
**/.ipynb_checkpoints/

# Двоичные научные данные и готовые изображения не дают полезного AST/графа.
*.fits
*.fit
*.fts
*.fz
*.npy
*.npz
*.pkl
*.pickle
*.sqlite
*.db
*.pdf
*.png
*.jpg
*.jpeg
*.tif
*.tiff
*.seq

# CSV, JSON, TXT, Markdown и TeX намеренно не исключены: в них лежат
# человекочитаемые результаты, параметры, статусы и выводы анализа.

# Артефакт самого codebase-memory не должен индексировать сам себя.
.codebase-memory/
